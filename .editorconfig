# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,markdown}]
# Markdown uses trailing double-space for a hard line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

[testdata/golden/**]
# Golden files are compared byte for byte (§17.3). No editor may touch them.
insert_final_newline = false
trim_trailing_whitespace = false

[testdata/fixtures/**]
insert_final_newline = false
trim_trailing_whitespace = false
